---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@config";
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero">
      <h1>Site Closed</h1>
      <p>
        因 blog 功能已經移植到 <a href="https://github.com/ashssa/laws">laws</a> 專案本體，因此 laws-blog 專案將不再更新。
      </p>
      <p>
        原部署在 Netlify 上的 <code>https://ashssa-law-blog.netlify.app/</code> 已經關閉。
      </p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  #hero {
    @apply pb-6 pt-8;
  }
  #hero h1 {
    @apply my-4 inline-block text-3xl font-bold sm:my-8 sm:text-5xl;
  }
  #hero p {
    @apply my-2;
  }
  #hero a {
    @apply text-skin-accent underline decoration-dashed underline-offset-4 hover:decoration-solid;
  }
</style>
